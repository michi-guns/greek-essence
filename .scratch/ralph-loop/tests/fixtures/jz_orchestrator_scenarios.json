{
  "version": 1,
  "scenarios": [
    {
      "id": "locale-parity-material",
      "trigger": "material locale-parity failure",
      "classification": "material",
      "transition": ["failure", "repair", "verify", "frontier-check", "stop"],
      "required_clauses": ["Material regression → repair.", "core bilingual parity"],
      "forbidden": ["accepted exception"]
    },
    {
      "id": "accessibility-affected-surface",
      "trigger": "accessibility failure on an affected surface",
      "classification": "material",
      "transition": ["failure", "repair", "verify", "frontier-check", "stop"],
      "required_clauses": ["Material regression → repair.", "accessibility"],
      "forbidden": ["accepted exception"]
    },
    {
      "id": "sensitive-failure-not-repairable",
      "trigger": "security, privacy, or data-integrity failure that cannot be repaired safely",
      "classification": "genuine-blocker",
      "transition": ["failure", "bounded-recovery", "pause-escalate", "handoff", "email", "stop"],
      "required_clauses": ["security, privacy, accessibility, data integrity", "A genuine blocker requires"],
      "forbidden": ["accepted exception"]
    },
    {
      "id": "stale-contract-conflicting-test",
      "trigger": "stale test conflicts with the accepted contract",
      "classification": "invalid-evidence",
      "transition": ["failure", "bounded-diagnosis", "correct-or-retire-invalid-check", "record-proof", "verify", "frontier-check", "stop"],
      "required_clauses": ["Invalid/stale/flaky evidence → bounded diagnosis", "correct or retire only the invalid check with recorded proof"],
      "forbidden": []
    },
    {
      "id": "windows-environmental-failure",
      "trigger": "known Windows environmental failure with stronger passing evidence",
      "classification": "low-impact-exception",
      "transition": ["failure", "bounded-investigation", "stronger-passing-evidence", "record-exception", "frontier-check", "stop"],
      "required_clauses": ["Known Windows environmental failure", "stronger passing evidence", "bounded investigation"],
      "forbidden": ["accepted exception for security, privacy, accessibility, data integrity, accepted user behavior, core bilingual parity, unusable builds, or unsupported claims"]
    },
    {
      "id": "marginal-non-contract-metric",
      "trigger": "marginal non-contract metric with a polished live result",
      "classification": "low-impact-exception",
      "transition": ["failure", "bounded-investigation", "record-exception", "continue-without-repeated-expensive-reruns", "frontier-check", "stop"],
      "required_clauses": ["Marginal non-contract metric", "polished live result", "without repeated expensive reruns"],
      "forbidden": ["accepted exception for security, privacy, accessibility, data integrity, accepted user behavior, core bilingual parity, unusable builds, or unsupported claims"]
    },
    {
      "id": "in-contract-review-failure",
      "trigger": "failed review with claimed in-contract findings",
      "classification": "tier-check-then-repair-or-record",
      "transition": ["review-failure", "tier-classification", "repair-blocking-or-record-higher-tier", "verify", "frontier-check", "stop"],
      "required_clauses": ["Route only tier-appropriate blocking findings to implementation; record Tier-3/4 requests as non-blocking.", "ordinary implementation, gate, or in-contract review failure is not a blocker, and it is not automatically a defect that requires repair"],
      "forbidden": ["pause"]
    },
    {
      "id": "genuine-credential-requirement",
      "trigger": "unavailable required credential",
      "classification": "genuine-blocker",
      "transition": ["failure", "handoff", "email", "pause", "completion-false", "stop"],
      "required_clauses": ["unavailable required credentials", "keep completion false", "send the blocker email", "pause-signal.json` true only for a genuine human-required blocker"],
      "forbidden": ["completion true"]
    },
    {
      "id": "frontier-advance-after-implementation",
      "trigger": "frontier advances after implementation",
      "classification": "one-action-boundary",
      "transition": ["implementation", "frontier-advances", "end-check", "stop"],
      "required_clauses": ["Once the CLI frontier advances, never start the successor frontier action in this iteration"],
      "forbidden": ["start review"]
    },
    {
      "id": "frontier-advance-after-review",
      "trigger": "frontier advances after review",
      "classification": "one-action-boundary",
      "transition": ["review", "frontier-advances", "end-check", "stop"],
      "required_clauses": ["Once the CLI frontier advances, never start the successor frontier action in this iteration", "Do not preselect a successor issue or perform its work."],
      "forbidden": ["contract next issue"]
    }
  ]
}
