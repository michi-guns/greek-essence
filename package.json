{
  "name": "greek-essence",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "deploy:vercel": "node --env-file-if-exists=.env.local scripts/deploy-vercel.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "knip": "knip",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:prototype-asset-prompts": "node scripts/validate-prototype-asset-prompts.mjs",
    "secrets:scan": "gitleaks git --redact --verbose .",
    "security:audit": "pnpm audit --audit-level=high",
    "quality:unlighthouse": "start-server-and-test \"pnpm start --port 3101\" http://127.0.0.1:3101 \"unlighthouse-ci --config-file unlighthouse.config.ts && node scripts/assert-unlighthouse-lcp.mjs\"",
    "check:static": "pnpm format:check && pnpm lint && pnpm knip && pnpm typecheck && pnpm validate:content",
    "check": "pnpm check:static && pnpm test:unit",
    "check:push": "pnpm secrets:scan && pnpm security:audit && pnpm check:static && pnpm test:unit:coverage && pnpm build && pnpm test:e2e",
    "check:all": "pnpm check:push && pnpm quality:unlighthouse",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "next": "16.2.12",
    "next-intl": "4.13.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "4.13.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@playwright/cli": "0.1.17",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "20.19.43",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@unlighthouse/cli": "0.18.0",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "knip": "6.29.0",
    "lint-staged": "17.1.0",
    "playwright-core": "1.61.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "puppeteer": "25.3.0",
    "start-server-and-test": "3.0.11",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,yaml,yml}": "prettier --write",
    "*.{md,mdx}": "prettier --write --ignore-path .gitignore"
  }
}
